<button @onclick="() => OnSelected.InvokeAsync(Name)">@Name</button>

@code {
    // TODO-02: Mark Name as required for the caller ([EditorRequired]) and make the
    // button invoke the EventCallback<string> with the name.
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public EventCallback<string> OnSelected { get; set; }
}
