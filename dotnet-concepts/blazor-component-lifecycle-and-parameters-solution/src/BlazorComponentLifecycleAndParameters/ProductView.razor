@inject IProductService Products

<p id="name">@name</p>

@code {
    private string? name;
    private int loadedId = -1;

    [Parameter] public int ProductId { get; set; }

    // A mutable parameter: the framework re-runs OnParametersSet on every parent render.
    [Parameter] public List<int> Tags { get; set; } = [];

    // TODO-03: Load only when ProductId really changed since the last load.
    protected override async Task OnParametersSetAsync()
    {
        if (ProductId == loadedId) return;
        loadedId = ProductId;
        name = await Products.GetNameAsync(ProductId);
    }
}
