<p id="value">Value: @Value</p>

@code {
    private int renderedValue = -1;

    public int RenderCount { get; private set; }

    public int ParametersSetCount { get; private set; }

    [Parameter] public int Value { get; set; }

    // Not displayed, so a change here should not cost a render.
    [Parameter] public int Other { get; set; }

    protected override void OnParametersSet() => ParametersSetCount++;

    // TODO-07 (optional): Override ShouldRender so the component skips the render unless
    // Value changed since the last render (renderedValue). The parameter hooks still run.

    protected override void OnAfterRender(bool firstRender)
    {
        renderedValue = Value;
        RenderCount++;
    }
}
