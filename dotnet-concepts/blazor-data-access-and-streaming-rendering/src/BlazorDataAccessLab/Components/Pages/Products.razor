@page "/products"
@* TODO-04: add the attribute that streams the placeholder first, then the data. *@
@inject IProductService Service
@inject ILoadGate Gate

<h1>Products</h1>

@if (items is null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var p in items)
        {
            <li>@p.Name</li>
        }
    </ul>
}

@code {
    private List<Product>? items;

    protected override async Task OnInitializedAsync()
    {
        // TODO-03: wait for the gate (await Gate.WaitAsync()), then load the list through Service.
        await Task.CompletedTask;
    }
}
